DRY_RUN=true
AUTO_REPLY=false
CUSTOM_SEARCH_PROFILES=false
MAX_MESSAGES_PER_CYCLE=1
INTERVAL_SECONDS=7200
JITTER_SECONDS=300
MIN_MESSAGE_PAUSE_SECONDS=180
MAX_MESSAGE_PAUSE_SECONDS=420
HEADLESS=false
BROWSER_ENGINE=playwright
BROWSER_CHANNEL=chromium
# Patchright requires a blank locale to preserve page/worker consistency.
BROWSER_LOCALE=
BROWSER_TIMEZONE=Europe/Berlin
DATA_DIR=data
SEARCH_PROFILES_PATH=config/search_profiles.yaml
RUNTIME_PATH=config/runtime.yaml
EXCLUSIONS_PATH=config/exclusions.yaml
MESSAGE_TEMPLATE_PATH=config/message_templates/base_de.txt
MESSAGE_VARIANTS_PATH=config/message_templates/variants.yaml
# Optional: used only if template contains {signature}.
SIGNATURE=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# Housing hub: never paste passwords/tokens into chat.
HOUSING_CONFIG_PATH=config/housing.yaml
# JSON array. Get your own numeric user ID with /whoami in the configured chat.
TELEGRAM_ALLOWED_USER_IDS=[]
# Use a dedicated Gmail label/folder Housing. Password is a Google app password.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
MIN_LISTING_PAUSE_SECONDS=30
MAX_LISTING_PAUSE_SECONDS=60
ALLOW_UNPRICED_REPLIES=false
TELEGRAM_EVENTS_CHAT_ID=
WATCH_INTERVAL_SECONDS=3600
WATCH_JITTER_SECONDS=600
FRESH_FIRST=true
EXCLUDED_RECHECK_SECONDS=21600
PREPARE_RETRY_SECONDS=3600
PREPARE_FAILURE_LIMIT=2
BROWSER_WINDOW_WIDTH=1000
BROWSER_WINDOW_HEIGHT=720
BROWSER_COLOR_SCHEME=dark
